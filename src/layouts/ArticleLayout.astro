---
/**
 * ArticleLayout.astro — Layout for Guides and Blog posts (AstroWind Style)
 */
import BaseLayout from './BaseLayout.astro';
import AdSlot from '../components/AdSlot.astro';
import { SITE, CONTACT } from '../lib/config';
import type { CollectionEntry } from 'astro:content';

interface Props {
  frontmatter: CollectionEntry<'guides'>['data'] | CollectionEntry<'blog'>['data'];
  slug: string;
  collection: 'guides' | 'blog';
  readingTime?: number;
}

const { frontmatter, slug, collection, readingTime = 5 } = Astro.props;
const canonicalUrl = new URL(`/${collection}/${slug}/`, SITE.url).href;
const ogImage = frontmatter.ogImage ?? frontmatter.heroImage ?? SITE.ogImage;

// Article Schema
const articleSchema = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  '@id': `${canonicalUrl}#article`,
  headline: frontmatter.title,
  description: frontmatter.description,
  image: ogImage ? new URL(ogImage, SITE.url).href : new URL(SITE.ogImage, SITE.url).href,
  datePublished: frontmatter.publishDate.toISOString(),
  dateModified: (frontmatter.updatedDate ?? frontmatter.publishDate).toISOString(),
  author: { '@id': `${SITE.url}/#organization` },
  publisher: { '@id': `${SITE.url}/#organization` },
  mainEntityOfPage: { '@type': 'WebPage', '@id': canonicalUrl },
  inLanguage: 'en',
};

// Breadcrumb Schema
const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: SITE.url + '/' },
    { '@type': 'ListItem', position: 2, name: collection === 'guides' ? 'Guides' : 'Blog', item: `${SITE.url}/${collection}/` },
    { '@type': 'ListItem', position: 3, name: frontmatter.title, item: canonicalUrl },
  ],
};

// FAQ Schema
const faqSchema = frontmatter.faqs?.length
  ? {
      '@context': 'https://schema.org',
      '@type': 'FAQPage',
      mainEntity: frontmatter.faqs.map((faq) => ({
        '@type': 'Question',
        name: faq.question,
        acceptedAnswer: { '@type': 'Answer', text: faq.answer },
      })),
    }
  : null;

const schemas = [articleSchema, breadcrumbSchema, ...(faqSchema ? [faqSchema] : [])];

const formattedDate = new Intl.DateTimeFormat('en-US', { year: 'numeric', month: 'long', day: 'numeric' }).format(frontmatter.publishDate);
---

<BaseLayout
  title={frontmatter.title}
  description={frontmatter.description}
  ogImage={ogImage ?? SITE.ogImage}
  ogType="article"
  canonicalUrl={canonicalUrl}
  jsonLd={schemas}
>
  <article class="py-8 md:py-12 mx-auto max-w-4xl px-4 sm:px-6">
    
    {/* Breadcrumbs */}
    <nav aria-label="Breadcrumb" class="mb-6">
      <ol class="flex items-center gap-1.5 text-xs text-slate-500 dark:text-slate-400">
        <li><a href="/" class="hover:text-primary-600 transition">Home</a></li>
        <li>/</li>
        <li><a href={`/${collection}/`} class="hover:text-primary-600 transition capitalize">{collection}</a></li>
        <li>/</li>
        <li class="text-slate-900 dark:text-white font-medium truncate max-w-[200px] sm:max-w-xs">{frontmatter.title}</li>
      </ol>
    </nav>

    {/* Header */}
    <header class="mb-8">
      {frontmatter.tags?.length > 0 && (
        <div class="flex flex-wrap gap-2 mb-3">
          {frontmatter.tags.map((tag: string) => (
            <span class="text-xs font-semibold px-2.5 py-0.5 rounded-full bg-blue-50 text-primary-700 dark:bg-slate-800 dark:text-blue-300">
              {tag}
            </span>
          ))}
        </div>
      )}

      <h1 class="text-3xl sm:text-4xl md:text-5xl font-bold font-heading tracking-tight mb-4 text-slate-900 dark:text-white leading-tight">
        {frontmatter.title}
      </h1>

      <div class="flex flex-wrap items-center gap-4 text-xs text-slate-500 dark:text-slate-400 py-3 border-y border-slate-100 dark:border-slate-800">
        <span>Published {formattedDate}</span>
        <span>·</span>
        <span>{readingTime} min read</span>
        <span>·</span>
        <span>By SK Immigration Advisory Team</span>
      </div>

      {/* Honest Policy Banner */}
      <div class="mt-4 p-4 rounded-2xl bg-slate-50 dark:bg-slate-900 border border-slate-200 dark:border-slate-800 text-xs text-slate-600 dark:text-slate-400 flex items-start gap-2.5">
        <span class="text-primary-600 font-bold text-sm">ℹ️</span>
        <div>
          <strong>Educational Resource:</strong> Visa requirements and financial criteria are researched from official embassy directives. Embassies hold exclusive visa granting authority. <a href="/about/" class="text-primary-600 dark:text-primary-400 font-semibold hover:underline">Verify our SECP registration →</a>
        </div>
      </div>
    </header>

    {/* Content Prose */}
    <div class="prose prose-slate dark:prose-invert max-w-none prose-headings:font-heading prose-headings:font-bold prose-a:text-primary-600 prose-img:rounded-2xl">
      <slot />
    </div>

    {/* In-Article Monetization Slot */}
    <AdSlot slotId="9876543210" format="auto" />

    {/* FAQ Accordion Section */}
    {frontmatter.faqs?.length > 0 && (
      <section class="mt-12 pt-8 border-t border-slate-200 dark:border-slate-800 not-prose">
        <h2 class="text-2xl font-bold font-heading mb-6 text-slate-900 dark:text-white">
          Frequently Asked Questions
        </h2>
        <div class="space-y-3">
          {frontmatter.faqs.map((faq: { question: string; answer: string }) => (
            <details class="group bg-slate-50 dark:bg-slate-900 p-5 rounded-2xl border border-slate-200 dark:border-slate-800">
              <summary class="flex justify-between items-center font-bold font-heading cursor-pointer text-slate-900 dark:text-white list-none text-base">
                <span>{faq.question}</span>
                <span class="transition-transform group-open:rotate-180 text-primary-600 ml-4">▾</span>
              </summary>
              <p class="mt-3 text-sm text-slate-600 dark:text-slate-400 leading-relaxed">
                {faq.answer}
              </p>
            </details>
          ))}
        </div>
      </section>
    )}

    {/* Bottom CTA Box */}
    <div class="mt-12 p-8 bg-slate-900 text-white rounded-3xl text-center not-prose">
      <h3 class="text-2xl font-bold font-heading mb-2">Have Questions About This Visa Pathway?</h3>
      <p class="text-slate-300 text-sm max-w-md mx-auto mb-6">
        Contact our Rawalpindi office for a free profile assessment before paying any fees.
      </p>
      <div class="flex flex-col sm:flex-row justify-center gap-3">
        <a href="/contact/" class="btn-primary bg-white text-slate-900 hover:bg-slate-100 py-2.5 px-5 text-sm">
          Book Free Assessment
        </a>
        <a href={CONTACT.whatsappLink} target="_blank" rel="noopener noreferrer" class="btn-whatsapp py-2.5 px-5 text-sm">
          WhatsApp {CONTACT.phoneFormatted}
        </a>
      </div>
    </div>

  </article>
</BaseLayout>
