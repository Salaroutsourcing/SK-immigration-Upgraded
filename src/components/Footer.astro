---
import { SITE, CONTACT, BUSINESS, SOCIAL, FOOTER_LINKS } from '../lib/config';

const currentYear = new Date().getFullYear();
---

<footer class="relative border-t border-gray-200 dark:border-slate-800 not-prose bg-slate-50 dark:bg-dark-950">
  <div class="relative max-w-7xl mx-auto px-4 sm:px-6 pointer-events-auto">
    <div class="grid grid-cols-12 gap-4 gap-y-8 sm:gap-8 py-12 md:py-16">
      
      {/* Brand Column */}
      <div class="col-span-12 lg:col-span-4 pr-0 lg:pr-8">
        <div class="mb-3">
          <a class="inline-flex items-center gap-3 font-bold text-xl text-slate-900 dark:text-white" href="/">
            <img
              src="/assets/logo.png"
              alt="SK Immigration Services"
              class="h-8 w-auto object-contain"
              width="32"
              height="32"
              loading="lazy"
            />
            <span>SK Immigration Services</span>
          </a>
        </div>
        <p class="text-sm text-slate-600 dark:text-slate-400 mb-4 leading-relaxed">
          {SITE.legalName} (SECP CUIN {BUSINESS.cuin}). Transparent immigration file preparation and student admissions from Rawalpindi, Pakistan.
        </p>
        <div class="text-xs text-slate-500 dark:text-slate-400 space-y-1">
          <p>📍 {CONTACT.address.street}, {CONTACT.address.city}</p>
          <p>📞 Phone/WhatsApp: <a href={`tel:${CONTACT.phone}`} class="hover:underline text-primary-600 dark:text-primary-400">{CONTACT.phoneFormatted}</a></p>
          <p>✉️ Email: <a href={`mailto:${CONTACT.email}`} class="hover:underline text-primary-600 dark:text-primary-400">{CONTACT.email}</a></p>
        </div>

        {/* Social Icons */}
        <div class="flex gap-3 mt-4">
          <a href={SOCIAL.facebook} target="_blank" rel="noopener noreferrer" class="text-slate-400 hover:text-primary-600 dark:hover:text-primary-400 transition" aria-label="Facebook">
            <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24"><path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/></svg>
          </a>
          <a href={SOCIAL.instagram} target="_blank" rel="noopener noreferrer" class="text-slate-400 hover:text-primary-600 dark:hover:text-primary-400 transition" aria-label="Instagram">
            <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24"><path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/></svg>
          </a>
          <a href={SOCIAL.youtube} target="_blank" rel="noopener noreferrer" class="text-slate-400 hover:text-primary-600 dark:hover:text-primary-400 transition" aria-label="YouTube">
            <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24"><path d="M23.498 6.186a3.016 3.016 0 0 0-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 0 0 .502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 0 0 2.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 0 0 2.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z"/></svg>
          </a>
          <a href={SOCIAL.linkedin} target="_blank" rel="noopener noreferrer" class="text-slate-400 hover:text-primary-600 dark:hover:text-primary-400 transition" aria-label="LinkedIn">
            <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24"><path d="M19 0h-14c-2.761 0-5 2.239-5 5v14c0 2.761 2.239 5 5 5h14c2.762 0 5-2.239 5-5v-14c0-2.761-2.238-5-5-5zm-11 19h-3v-11h3v11zm-1.5-12.268c-.966 0-1.75-.79-1.75-1.764s.784-1.764 1.75-1.764 1.75.79 1.75 1.764-.783 1.764-1.75 1.764zm13.5 12.268h-3v-5.604c0-3.368-4-3.113-4 0v5.604h-3v-11h3v1.765c1.396-2.586 7-2.777 7 2.476v6.759z"/></svg>
          </a>
        </div>
      </div>

      {/* Services Links */}
      <div class="col-span-6 md:col-span-3 lg:col-span-2">
        <div class="text-slate-900 dark:text-slate-200 font-semibold mb-3 text-sm">Services</div>
        <ul class="space-y-2 text-sm">
          {FOOTER_LINKS.services.map((link) => (
            <li>
              <a href={link.href} class="text-slate-600 dark:text-slate-400 hover:text-primary-600 dark:hover:text-primary-400 transition duration-150">
                {link.label}
              </a>
            </li>
          ))}
        </ul>
      </div>

      {/* Resources Links */}
      <div class="col-span-6 md:col-span-3 lg:col-span-2">
        <div class="text-slate-900 dark:text-slate-200 font-semibold mb-3 text-sm">Resources</div>
        <ul class="space-y-2 text-sm">
          {FOOTER_LINKS.resources.map((link) => (
            <li>
              <a href={link.href} class="text-slate-600 dark:text-slate-400 hover:text-primary-600 dark:hover:text-primary-400 transition duration-150">
                {link.label}
              </a>
            </li>
          ))}
        </ul>
      </div>

      {/* Legal & Compliance Links */}
      <div class="col-span-6 md:col-span-3 lg:col-span-2">
        <div class="text-slate-900 dark:text-slate-200 font-semibold mb-3 text-sm">Company & Trust</div>
        <ul class="space-y-2 text-sm">
          {FOOTER_LINKS.legal.map((link) => (
            <li>
              <a href={link.href} class="text-slate-600 dark:text-slate-400 hover:text-primary-600 dark:hover:text-primary-400 transition duration-150">
                {link.label}
              </a>
            </li>
          ))}
          <li>
            <a href="https://leap.secp.gov.pk" target="_blank" rel="noopener noreferrer" class="text-slate-600 dark:text-slate-400 hover:text-primary-600 dark:hover:text-primary-400 transition duration-150">
              SECP Verification ↗
            </a>
          </li>
        </ul>
      </div>

      {/* Trust Notice Box */}
      <div class="col-span-6 md:col-span-3 lg:col-span-2">
        <div class="text-slate-900 dark:text-slate-200 font-semibold mb-3 text-sm">Honest Policy</div>
        <div class="text-xs text-slate-500 dark:text-slate-400 leading-relaxed bg-white dark:bg-dark-900 p-3.5 rounded-xl border border-slate-200 dark:border-slate-800">
          <p class="font-medium text-slate-800 dark:text-slate-200 mb-1">No Visa Guarantees</p>
          Embassies and consulates hold exclusive authority over visa outcomes. We never sell visa promises.
        </div>
      </div>

    </div>

    {/* Bottom Bar */}
    <div class="md:flex md:items-center md:justify-between py-6 md:py-8 border-t border-slate-200 dark:border-slate-800 text-sm text-slate-500 dark:text-slate-400">
      <div>
        © {currentYear} · <a class="text-slate-900 hover:underline font-semibold dark:text-white" href="/">{SITE.name}</a>. All rights reserved.
      </div>
      <div class="mt-4 md:mt-0 text-xs">
        SECP Registered · SMC-Private Limited · CUIN 0304985
      </div>
    </div>
  </div>
</footer>
