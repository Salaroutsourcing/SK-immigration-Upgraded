---
import { SITE, CONTACT, NAVIGATION } from '../lib/config';
---

<header
  class="sticky top-0 z-40 flex-none mx-auto w-full border-b border-gray-50/0 transition-[opacity] ease-in-out bg-white/90 dark:bg-dark-950/90 backdrop-blur-md border-slate-100 dark:border-slate-800"
  id="header"
>
  <div class="absolute inset-0"></div>
  <div
    class="relative text-default py-3.5 px-3 md:px-6 mx-auto w-full md:flex md:justify-between max-w-7xl"
  >
    <div class="flex justify-between items-center">
      <a class="flex items-center gap-3 font-bold text-lg md:text-xl text-slate-900 dark:text-white" href="/">
        <img
          src="/assets/logo.png"
          alt="SK Immigration Services Logo"
          class="h-10 w-auto object-contain"
          width="40"
          height="40"
          loading="eager"
        />
        <div class="flex flex-col">
          <span class="tracking-tight hover:text-primary-600 dark:hover:text-primary-400 transition-colors leading-tight font-heading">
            SK Immigration Services
          </span>
          <span class="text-[10px] text-slate-500 dark:text-slate-400 font-medium tracking-normal">
            SECP CUIN 0304985
          </span>
        </div>
      </a>
      <div class="flex items-center md:hidden">
        <button
          type="button"
          class="text-gray-500 dark:text-gray-400 hover:bg-gray-100 dark:hover:bg-gray-700 focus:outline-none rounded-lg text-sm p-2.5 inline-flex items-center"
          aria-label="Toggle Menu"
          id="mobile-menu-btn"
        >
          <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"></path>
          </svg>
        </button>
      </div>
    </div>

    <nav
      class="items-center w-full md:w-auto hidden md:flex text-slate-600 dark:text-slate-200 h-[calc(100vh-72px)] md:h-auto overflow-y-auto md:overflow-visible justify-self-end mt-4 md:mt-0"
      aria-label="Main navigation"
      id="navigation-menu"
    >
      <ul
        class="flex flex-col md:flex-row md:self-center w-full md:w-auto text-xl md:text-[0.9375rem] tracking-[0.01rem] font-medium md:justify-center"
      >
        {NAVIGATION.map((item) => (
          <li>
            <a
              class="hover:text-primary-600 dark:hover:text-primary-400 px-4 py-3 flex items-center transition duration-150 ease-in-out"
              href={item.href}
            >
              {item.label}
            </a>
          </li>
        ))}
      </ul>
    </nav>

    <div class="items-center md:flex gap-3 hidden">
      {/* Theme Toggle */}
      <button
        type="button"
        class="text-slate-500 dark:text-slate-400 hover:bg-slate-100 dark:hover:bg-slate-800 focus:outline-none rounded-lg text-sm p-2.5 inline-flex items-center"
        aria-label="Toggle Dark Mode"
        id="theme-toggle"
      >
        <svg id="sun-icon" class="w-5 h-5 hidden" fill="currentColor" viewBox="0 0 20 20">
          <path d="M10 2a1 1 0 011 1v1a1 1 0 11-2 0V3a1 1 0 011-1zm4 8a4 4 0 11-8 0 4 4 0 018 0zm-.464 4.95l.707.707a1 1 0 001.414-1.414l-.707-.707a1 1 0 00-1.414 1.414zm2.12-10.607a1 1 0 010 1.414l-.706.707a1 1 0 11-1.414-1.414l.707-.707a1 1 0 011.414 0zM17 11a1 1 0 100-2h-1a1 1 0 100 2h1zm-7 4a1 1 0 011 1v1a1 1 0 11-2 0v-1a1 1 0 011-1zM5.05 6.464A1 1 0 106.465 5.05l-.708-.707a1 1 0 00-1.414 1.414l.707.707zm1.414 8.486l-.707.707a1 1 0 01-1.414-1.414l.707-.707a1 1 0 011.414 1.414zM4 11a1 1 0 100-2H3a1 1 0 000 2h1z" fill-rule="evenodd" clip-rule="evenodd"></path>
        </svg>
        <svg id="moon-icon" class="w-5 h-5" fill="currentColor" viewBox="0 0 20 20">
          <path d="M17.293 13.293A8 8 0 016.707 2.707a8.001 8.001 0 1010.586 10.586z"></path>
        </svg>
      </button>

      {/* AstroWind action button */}
      <a
        href="/contact/"
        class="btn-primary py-2 px-5 text-sm font-semibold shadow-none md:px-5"
      >
        Free Consultation
      </a>
    </div>
  </div>
</header>

<script>
  // Theme Toggle
  const themeToggle = document.getElementById('theme-toggle');
  const sunIcon = document.getElementById('sun-icon');
  const moonIcon = document.getElementById('moon-icon');

  function updateThemeUI() {
    const isDark = document.documentElement.classList.contains('dark');
    sunIcon?.classList.toggle('hidden', !isDark);
    moonIcon?.classList.toggle('hidden', isDark);
  }

  updateThemeUI();

  themeToggle?.addEventListener('click', () => {
    const isDark = document.documentElement.classList.toggle('dark');
    localStorage.setItem('theme', isDark ? 'dark' : 'light');
    updateThemeUI();
  });

  // Mobile menu
  const menuBtn = document.getElementById('mobile-menu-btn');
  const navMenu = document.getElementById('navigation-menu');

  menuBtn?.addEventListener('click', () => {
    navMenu?.classList.toggle('hidden');
  });
</script>
