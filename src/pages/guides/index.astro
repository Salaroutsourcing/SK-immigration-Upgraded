---
/**
 * guides/index.astro — Country & Service Guides (AstroWind Style)
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { SITE } from '../../lib/config';

const guides = await getCollection('guides');
const sortedGuides = guides.sort((a, b) =>
  b.data.publishDate.getTime() - a.data.publishDate.getTime()
);
---

<BaseLayout
  title="Country & Visa Guides — SK Immigration Services"
  description="In-depth, embassy-verified immigration guides for Pakistani applicants: Germany Ausbildung, UK student visas, Canada SDS, and Saudi work files."
  canonicalUrl={`${SITE.url}/guides/`}
>
  <section class="py-12 md:py-16 bg-slate-50 dark:bg-dark-950 border-b border-slate-200 dark:border-slate-800 not-prose">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 text-center">
      <p class="text-base text-primary-600 dark:text-blue-400 font-semibold tracking-wide uppercase mb-2">
        Knowledge Base
      </p>
      <h1 class="text-3xl md:text-5xl font-bold font-heading mb-4 text-slate-900 dark:text-white">
        Immigration &amp; Country Guides
      </h1>
      <p class="text-lg text-slate-600 dark:text-slate-400 max-w-2xl mx-auto">
        Deep, realistic breakdowns of admissions, blocked accounts, language prerequisites, and embassy checklists.
      </p>
    </div>
  </section>

  <section class="section-container">
    <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-8">
      {sortedGuides.map((guide) => (
        <article class="flex flex-col bg-white dark:bg-slate-900 rounded-3xl border border-slate-200 dark:border-slate-800 shadow-sm hover:border-primary-500/40 transition overflow-hidden">
          <div class="p-6 flex-1 flex flex-col">
            <div class="flex items-center gap-2 mb-3">
              <span class="text-xs font-semibold px-2.5 py-0.5 rounded-full bg-blue-50 text-primary-700 dark:bg-slate-800 dark:text-blue-300">
                {guide.data.country}
              </span>
              <span class="text-xs text-slate-500">{guide.data.visaType}</span>
            </div>
            <h2 class="text-xl font-bold font-heading mb-2 text-slate-900 dark:text-white hover:text-primary-600 transition">
              <a href={`/guides/${guide.slug}/`}>
                {guide.data.title}
              </a>
            </h2>
            <p class="text-sm text-slate-600 dark:text-slate-400 leading-relaxed mb-4 flex-1">
              {guide.data.description}
            </p>
            <div class="pt-4 border-t border-slate-100 dark:border-slate-800 flex items-center justify-between">
              <a href={`/guides/${guide.slug}/`} class="text-sm font-semibold text-primary-600 dark:text-primary-400 hover:underline">
                Read Guide →
              </a>
              <span class="text-xs text-slate-400">Embassy Verified</span>
            </div>
          </div>
        </article>
      ))}
    </div>
  </section>
</BaseLayout>
